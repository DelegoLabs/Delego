{
  "ci": {
    "collect": {
      "staticDistDir": null,
      // Every URL must render for an anonymous visitor. /orders is listed in
      // middleware.ts's PROTECTED_ROUTES, so an unauthenticated request to it is
      // redirected to /login — which has no page yet — and Lighthouse aborts the
      // whole run with "unable to reliably load the page (Status code: 404)".
      // /approvals is the heaviest authenticated-surface route that is public,
      // so the budget still measures a first-load of realistic weight.
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/escrows",
        "http://localhost:3100/approvals"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
