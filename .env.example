# =============================================================================
# Delego Frontend — Environment Configuration
# Copy to .env.local and adjust values for local development.
# ===========================================================================

# --- General ---
NODE_ENV=development

# --- Web App ---
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Feature Flags ---
# Set to 'true', '1', or 'on' to enable a feature flag statically at build/runtime.
NEXT_PUBLIC_FEATURE_CLIENT_SIDE_SIGNING=false

# --- Contract Registry (Settings -> Network & Contracts) ---
# Deployed Soroban contract addresses (StrKey "C..." form) per network. Shown
# read-only in Settings with live-fetched versions and explorer links.
NEXT_PUBLIC_ESCROW_CONTRACT_ID_TESTNET=
NEXT_PUBLIC_PERMISSIONS_CONTRACT_ID_TESTNET=
NEXT_PUBLIC_REGISTRY_CONTRACT_ID_TESTNET=
NEXT_PUBLIC_ESCROW_CONTRACT_ID_MAINNET=
NEXT_PUBLIC_PERMISSIONS_CONTRACT_ID_MAINNET=
NEXT_PUBLIC_REGISTRY_CONTRACT_ID_MAINNET=

