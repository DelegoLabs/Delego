{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "state/**/*.ts",
    "workflows/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "workflows/**/*.test.ts",
    "state/**/*.test.ts"
  ]
}
