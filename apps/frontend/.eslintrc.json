{
  "root": true,
  "extends": ["next/core-web-vitals", "prettier", "plugin:boundaries/recommended"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "boundaries"],
  "settings": {
    "boundaries/include": ["components/**/*"],
    "boundaries/elements": [
      { "type": "feature-analytics",       "pattern": "components/analytics/**"       },
      { "type": "feature-agent",           "pattern": "components/agent/**"           },
      { "type": "feature-storefront",      "pattern": "components/storefront/**"      },
      { "type": "feature-announcements",   "pattern": "components/announcements/**"   },
      { "type": "feature-command-palette", "pattern": "components/command-palette/**" },
      { "type": "feature-delegations",     "pattern": "components/delegations/**"     },
      { "type": "feature-escrows",         "pattern": "components/escrows/**"         },
      { "type": "feature-filters",         "pattern": "components/filters/**"         },
      { "type": "feature-merchant",        "pattern": "components/merchant/**"        },
      { "type": "feature-layout",          "pattern": "components/layout/**"          },
      { "type": "feature-network",         "pattern": "components/network/**"         },
      { "type": "feature-notifications",   "pattern": "components/notifications/**"   },
      { "type": "feature-onboarding",      "pattern": "components/onboarding/**"      },
      { "type": "feature-orders",          "pattern": "components/orders/**"          },
      { "type": "feature-providers",       "pattern": "components/providers/**"       },
      { "type": "feature-pwa",             "pattern": "components/pwa/**"             },
      { "type": "feature-search",          "pattern": "components/search/**"          },
      { "type": "feature-settings",        "pattern": "components/settings/**"        },
      { "type": "feature-wallet",          "pattern": "components/wallet/**"          },
      { "type": "shared",                  "pattern": "components/*.tsx"              }
    ]
  },
  "rules": {
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "boundaries/element-types": [
      "error",
      {
        "default": "disallow",
        "message": "Cross-feature import blocked. Import via the feature's public.ts barrel instead (e.g. 'components/orders/public').",
        "rules": [
          {
            "from": ["shared"],
            "allow": [
              "feature-delegations",
              "feature-orders",
              "feature-escrows",
              "feature-wallet",
              "feature-settings",
              "feature-notifications",
              "feature-agent",
              "feature-analytics",
              "feature-storefront",
              "feature-announcements",
              "feature-command-palette",
              "feature-filters",
              "feature-layout",
              "feature-merchant",
              "feature-network",
              "feature-onboarding",
              "feature-providers",
              "feature-pwa",
              "feature-search"
            ]
          },
          {
            "from": [
              "feature-agent",
              "feature-analytics",
              "feature-storefront",
              "feature-announcements",
              "feature-command-palette",
              "feature-delegations",
              "feature-escrows",
              "feature-filters",
              "feature-layout",
              "feature-merchant",
              "feature-network",
              "feature-notifications",
              "feature-onboarding",
              "feature-orders",
              "feature-providers",
              "feature-pwa",
              "feature-search",
              "feature-settings",
              "feature-wallet"
            ],
            "allow": [
              "shared",
              "feature-agent",
              "feature-analytics",
              "feature-storefront",
              "feature-announcements",
              "feature-command-palette",
              "feature-delegations",
              "feature-escrows",
              "feature-filters",
              "feature-layout",
              "feature-merchant",
              "feature-network",
              "feature-notifications",
              "feature-onboarding",
              "feature-orders",
              "feature-providers",
              "feature-pwa",
              "feature-search",
              "feature-settings",
              "feature-wallet"
            ]
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["node_modules/", ".next/", "dist/"]
}
