{
  "name": "@delegolabs/web",
  "version": "0.0.1",
  "private": true,
  "description": "Delego consumer web application",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:microcopy": "node scripts/check-microcopy.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --project=visual --project=visual-mobile",
    "visual:update": "playwright test --project=visual --project=visual-mobile --update-snapshots",
    "analyze": "ANALYZE=true pnpm build",
    "check:perf-budget": "node scripts/check-perf-budget.mjs",
    "check:help-links": "node scripts/check-help-links.mjs"
  },
  "dependencies": {
    "@delegolabs/api-generated": "workspace:*",
    "@delegolabs/types": "workspace:*",
    "@delegolabs/ui": "workspace:*",
    "@sentry/nextjs": "^8.47.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^13.1.0",
    "next": "^15.1.0",
    "next-intl": "^3.26.0",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "recharts": "^2.15.0",
    "zod": "^3.24.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@next/bundle-analyzer": "^15.1.0",
    "@playwright/test": "^1.49.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "5.0.1",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
