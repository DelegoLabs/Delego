# API
NEXT_PUBLIC_API_URL=https://api.example.com

# Sentry (#511) — leave NEXT_PUBLIC_SENTRY_DSN unset to disable error reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1
# Server-only — required to upload source maps during `next build` in CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Web Vitals (#512) — reuses the Sentry DSN above as the reporting transport when set.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Docs site base URL (#638) — contextual help links resolve against this.
# Defaults to the GitHub repo path in local dev when unset.
NEXT_PUBLIC_DOCS_URL=

# Anti-phishing canonical-domain check (#593) — comma-separated list of the
# real, trusted hostname(s) this app is served from (e.g. "delego.app" or
# "delego.app,www.delego.app"). When set, a persistent warning banner shows
# if the app is running on any other host (local dev and Vercel PR previews
# are always exempt). Leave unset to disable the check entirely.
NEXT_PUBLIC_CANONICAL_HOSTS=
