{
  "name": "@delegolabs/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared React UI components for Delego apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: add eslint'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:no-coverage-ignores": "node scripts/check-no-coverage-ignores.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "swr": "^2.5.1"
  }
}
